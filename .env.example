# ---- required ----
# Root URL of the Planka instance. "/api" is appended automatically if missing.
PLANKA_BASE_URL=https://planka.example.com

# ---- auth (pick ONE) ----
# Preferred: long-lived API key (Planka: user settings -> API key)
PLANKA_API_KEY=
# Fallback: email/username + password. A token is fetched on start and refreshed on 401.
PLANKA_EMAIL=
PLANKA_PASSWORD=

# ---- scope / safety ----
# Optional allowlist. Comma-separated board IDs. If set, every tool refuses to
# touch cards on any other board.
PLANKA_BOARD_IDS=

# ---- status model ----
# Planka has no status field: status = which list a card sits in.
# List names are matched by heuristic (backlog/todo/ready -> todo,
# doing/in progress/wip -> in_progress, review/qa -> review, done/closed -> done).
# Override with JSON, either form:
#   name form   : {"todo": ["up next"], "in_progress": ["dev"]}
#   list-id form: {"<boardId>": {"todo": "<listId>", "in_progress": "<listId>"}}
PLANKA_STATUS_LISTS=

# ---- optional extra filters for list_actionable_tasks (default: off) ----
# Cards carrying any of these labels are hidden from the actionable queue.
PLANKA_BLOCKED_LABELS=
# true -> hide cards whose checklist tasks link to cards that are not done yet.
PLANKA_REQUIRE_DEPS_MET=false
# true -> allow done -> todo / done -> in_progress transitions.
PLANKA_ALLOW_REOPEN=false

# ---- transport / http ----
PLANKA_TRANSPORT=stdio
PLANKA_HTTP_HOST=127.0.0.1
PLANKA_HTTP_PORT=8000
PLANKA_TIMEOUT=20
# Some instances sit behind a WAF that blocks default python HTTP user agents.
PLANKA_USER_AGENT=planka-mcp/0.1

# Planka 2.4 board types: project | library | collection. Only 'project' boards
# hold work; library/collection boards hold documents and references. Set to an
# empty value to scan every board type.
PLANKA_BOARD_TYPES=project

# ---- role model ----
# Cap what the agent may do, regardless of how powerful the account is.
# guest (read only) | worker (own work) | editor (+ author, assign, structure)
# | admin (+ membership). Unset = use the account's real rights per board.
PLANKA_ACT_AS=

# Instance-level user administration (create users, change instance roles,
# project managers). Off by default; an agent with this on can grant roles.
PLANKA_ALLOW_USER_ADMIN=false
